---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseCard from '../../components/CourseCard.astro';
import { getCourses } from '../../data/courses';

const locale = 'zh' as const;
const courses = getCourses(locale);
---

<BaseLayout
  title="Tommy's Notes"
  description="用教學內容整理前端、後端、資料庫與系統主題的學習過程。"
  showPrimaryNav={false}
  locale={locale}
>
  <section class="hero hero--home">
    <div class="hero-backdrop"></div>
    <div class="container hero-inner hero-inner--home">
      <div class="hero-copy">
        <p class="lead">
          這個網站不是日記，而是把每次學到的觀念、範例與整理，寫成可以回頭複習的教學內容。
          每一篇內容都是我的學習紀錄，也是未來能再次使用的知識資產。
        </p>
      </div>
      <div class="hero-decor" aria-hidden="true">
        <svg class="hero-decor-starburst" viewBox="0 0 100 100"><g stroke="currentColor" stroke-width="4" stroke-linecap="round"><line x1="50" y1="8" x2="50" y2="92"/><line x1="8" y1="50" x2="92" y2="50"/><line x1="20" y1="20" x2="80" y2="80"/><line x1="80" y1="20" x2="20" y2="80"/></g><circle cx="50" cy="50" r="6" fill="currentColor"/></svg>
        <div class="hero-decor-blob"></div>
        <div class="hero-decor-boomerang"></div>
      </div>
    </div>
  </section>

  <section class="floating-panel-wrap">
    <div class="container">
      <div class="main-panel">
        <section class="panel-section panel-section--first" id="course-series">
          <div class="section-heading section-heading--editorial">
            <h2>學習主題</h2>
            <p>目前用多條主題線持續整理我的學習內容。</p>
          </div>

          <div class="course-grid course-grid--editorial">
            {courses.map((course) => (
              <CourseCard course={course} locale={locale} />
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
